class Solution:
    def maxArea(self, height: List[int]) -> int:
        curr = 0
        maxArea = 0

        left = 0
        right = len(height)-1

        if height[0] < height[1]:
            maxArea = 1*height[0]
        else:
            maxArea = 1*height[1]

        for i, h1 in enumerate (height):
            for j, h2 in enumerate (height):
                if h2>h1:
                    curr = (j-i)*h1
                else:
                    curr = (j-i)*h2
                
                if curr > maxArea:
                    maxArea=curr
        return maxArea
