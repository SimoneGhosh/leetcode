class Solution:
    def maxArea(self, height: List[int]) -> int:
        curr = 0
        maxArea = 0

        left = 0
        right = len(height)-1

        if height[0] < height[1]:
            maxArea = 1*height[0]
        else:
            maxArea = 1*height[1]

        while left<right:
            if height[left] < height[right]:
                curr = height[left]* (right-left)
                left += 1
            
            else:
                curr = height[right]* (right-left)
                right -= 1
            
            if curr > maxArea:
                maxArea=curr
        
        return maxArea
